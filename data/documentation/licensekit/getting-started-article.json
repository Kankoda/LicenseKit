{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/licensekit\/getting-started-article"]}],"metadata":{"title":"Getting Started","role":"article","modules":[{"name":"LicenseKit"}],"roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/src.LicenseKit\/documentation\/LicenseKit"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/Getting-Started-Article"},"kind":"article","abstract":[{"type":"text","text":"This article describes how to get started with LicenseKit."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use LicenseKit in your product, simply create an internal "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEngine"},{"text":" and add one or many ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType","isActive":true},{"text":"s to it, to determine from where it will try to find or fetch licenses.","type":"text"}]},{"type":"heading","level":2,"anchor":"License-Engine","text":"License Engine"},{"type":"paragraph","inlineContent":[{"text":"To create a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEngine"},{"text":" instance, you must pass in your ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/kankoda.com\/licensekit"},{"type":"text","text":", then inject the "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType","type":"reference","isActive":true},{"type":"text","text":"(s) that you want to use to validate your customer licenses."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For instance, this would create a license engine with two licenses that are compiled into your product and will be validated on-device:"}]},{"type":"codeListing","code":["let myEngine = try await LicenseEngine(","    licenseKey: \"your-license-key\",","    licenseService: { license in","        .binary(","            licenses: [","                License(licenseKey: \"license-key-1\", ...),","                License(licenseKey: \"license-key-2\", ...)","            ]","        )","    }",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See the "},{"type":"reference","identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Services-Article","isActive":true},{"type":"text","text":" article for a list of the available service types. You can define licenses with code, parse CSV or encrypted files, integrate with Gumroad or any 3rd party API, etc."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once your app\/SDK has a license engine, it can use "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEngine\/getLicense(withKey:)","type":"reference","isActive":true},{"type":"text","text":" to get and validate licenses. The engine will perform a basic license validation, after which you can perform additional validations on the current license."}]},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When using LicenseKit in an SDK, make sure to keep the license engine internal, to avoid that your users can access your licenses!"}]}]},{"text":"License Store","type":"heading","level":2,"anchor":"License-Store"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most apps & SDKs will have a single license per running instance. For these cases, you can use a "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseStore","type":"reference","isActive":true},{"type":"text","text":" to store the license."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can create an internal or private license store for your app\/SDK, then add a "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License","type":"reference","isActive":true},{"type":"text","text":" extensions to easily fetch the current license:"}]},{"type":"codeListing","syntax":"swift","code":["extension LicenseStore {","    static let myStore = LicenseStore()","}","","extension License {","    var current: License {","        License.current(in: .myStore)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"You can inject the store into your ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEngine"},{"text":" to automatically store licenses that you receive with ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEngine\/getLicense(withKey:)"},{"text":":","type":"text"}]},{"type":"codeListing","code":["let myEngine = try await LicenseEngine(","    licenseKey: \"your-license-key\",","    licenseStore: .myStore,","    licenseService: { license in ... }",")"],"syntax":"swift"},{"style":"warning","type":"aside","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Make sure to keep your license store and license engine internal, to avoid that your users can access them and inject fake licenses."}]}]},{"text":"License Registration","type":"heading","level":2,"anchor":"License-Registration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your software should provide a way for your customers to enter their license key. An app can have a UI\/screen, while an SDK can have a well-defined setup function like this one:"}]},{"type":"codeListing","syntax":"swift","code":["public final class MyLibrary {","","    \/\/ Place this kind of function in your library, where it makes sense. ","    \/\/ You don't need license keys when you use license files.","    public static func setupMyLibrary(","        withLicenseKey key: String? = nil","    ) async throws {","        let license = try await myEngine.getLicense(for: key)","        \/\/ If we get a license value, then the license is valid for the","        \/\/ current date, product, and platform. We can now perform more","        \/\/ validations, set up the app\/SDK using the license, store the","        \/\/ license for later feature\/tier validations, etc.","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The engine will retrieve and validate the first matching license from its "},{"type":"reference","identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType","isActive":true},{"type":"text","text":"s, if any, else throw a "},{"type":"reference","identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseError","isActive":true},{"type":"text","text":"."}]},{"type":"aside","style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Some license services, like "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType\/licenseFile(fileName:fileExtension:fileGenerator:fileBundle:)","type":"reference","isActive":true},{"type":"text","text":" doesn’t need a license key."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use a "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseRegistrationView","type":"reference","isActive":true},{"type":"text","text":" inside your own product-specific license registration view to register a license before rendering the view:"}]},{"type":"codeListing","code":["public struct MyLicesenseRegistrationView<Content: View>: View {","    ","    public init(","        licenseKey: String? = nil,","        content: @escaping () -> Content","    ) {","        self.licenseKey = licenseKey","        self.content = content","    }","    ","    private let licenseKey: String?","    private let content: @escaping () -> Content","    ","    public body: some View {","        LicenseRegistrationView(licenseKey: licenseKey, engine: { try await myEngine }) {","            content() \/\/ The license is valid, render the content view.","        } invalidContent: {","            \/\/ The license is invalid, render an optional failure view. ","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can instruct your customers to wrap "},{"type":"emphasis","inlineContent":[{"text":"their","type":"text"}]},{"type":"text","text":" app’s root view in this view to make sure that their license is registered before the app is rendered. Just be aware that network validation can take some time, in case you need a nice placeholder."}]},{"type":"heading","level":2,"text":"License Validation","anchor":"License-Validation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEngine"},{"type":"text","text":" will perform an initial license validation for the current date, product, and platform, which means that the license you get from it will meet this base requirements. You can then perform additional validations at any later time, to protect your software."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For instance, you can define a product-specific "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseFeature"},{"type":"text","text":" enum like this, to make sure that a user has access to that feature:"}]},{"type":"codeListing","code":["enum MyFeature: String, LicenseFeature {","","    case pins, maps, weather, ...","","    var featureId: String? {","        switch self {","        case .pins: nil         \/\/ Pins doesn't require a license","        case .maps: .silver","        case .weather: .gold","        }","    }","","    var unlockedByTier: LicenseTier? {","        switch self {","        case .pins: nil         \/\/ Pins doesn't require a license","        case .maps: .silver","        case .weather: .gold","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can now validate that a license can access a feature, and even make it impossible to create types that are unavailable to the license:"}]},{"type":"codeListing","code":["\/\/ See \"License Store\" section.","public extension License {","","    var current: License { ... }","}","","\/\/ This feature only requires that a license exists.","public class MyBasicFeature {","    public init() throws {","        try License.validate(.current)","    }","}","","\/\/\/ This feature requires a license with the .maps feature.","public class MyMapsFeature {","    public init() throws {","        try License.validate(.current) { license in","            try license.validateFeature(MyFeature.maps)","        }","    }","}","","\/\/\/ This feature requires a license with the .weather feature.","public class MyWeatherFeature {","    public init() throws {","        try License.validate(.current) { license in","            try license.validateFeature(MyFeature.weather)","        }","    }","}"],"syntax":"swift"},{"type":"aside","name":"Tip","style":"tip","content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/validate(_:isSwiftUIPreviewAllowed:bundleId:date:platform:environment:productVersion:additionalValidation:)"},{"text":" to ensure that the license exists and is valid, after which you can perform additional validations.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use a "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseValidationView","type":"reference","isActive":true},{"type":"text","text":" in your license-unlocked views to validate the current license before rendering the view:"}]},{"code":["public struct MyWeatherView: View {","    ","    public init() {}","    ","    public body: some View {","        LicenseValidationView(license: .current, feature: MyFeature.weather) {","            \/\/ The license is valid, render content.","        } invalidContent: {","            \/\/ The license is invalid, render an optional failure view. ","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Apps","type":"heading","level":2,"anchor":"Apps"},{"type":"paragraph","inlineContent":[{"type":"text","text":"LicenseKit has SwiftUI Previews-based apps templates that can be used by your app\/SDK’s source code to quickly create license apps."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseApp","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseManagerApp","type":"reference","isActive":true}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A separate article will be created for this."}]},{"text":"Demo apps and inspiration","type":"heading","level":2,"anchor":"Demo-apps-and-inspiration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Have a look at the demo app and demo library for examples on how to do this. LicenseKit doesn’t put any restrictions on how you use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEngine"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseStore"},{"type":"text","text":", but you can use these demos for inspiration."}]},{"text":"Further reading","type":"heading","level":2,"anchor":"Further-reading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more information, the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/Licenses-Article"},{"type":"text","text":" article explains the license model, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Services-Article"},{"type":"text","text":" the available services, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Files-Article"},{"type":"text","text":" how to generate encrypted license files."}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"anchor":"Articles","identifiers":["doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/Licenses-Article","doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Services-Article","doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Files-Article"],"title":"Articles","generated":true}],"references":{"doc://src.LicenseKit/documentation/LicenseKit/LicenseEngine":{"type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LicenseEngine","kind":"identifier"}],"url":"\/documentation\/licensekit\/licenseengine","navigatorTitle":[{"text":"LicenseEngine","kind":"identifier"}],"title":"LicenseEngine","kind":"symbol","abstract":[{"text":"This class is the most central type in LicenseKit and is","type":"text"},{"text":" ","type":"text"},{"text":"used to fetch licenses using an injected license service.","type":"text"}],"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEngine"},"doc://src.LicenseKit/documentation/LicenseKit/LicenseStore":{"kind":"symbol","abstract":[{"type":"text","text":"This actor can be used to store a single, active license."}],"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseStore","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"te