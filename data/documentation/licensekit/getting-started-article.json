{"sections":[],"variants":[{"paths":["\/documentation\/licensekit\/getting-started-article"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/Getting-Started-Article","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"LicenseKit"}],"roleHeading":"Article","role":"article","title":"Getting Started"},"hierarchy":{"paths":[["doc:\/\/src.LicenseKit\/documentation\/LicenseKit"]]},"kind":"article","abstract":[{"type":"text","text":"This article describes how to get started with LicenseKit."}],"seeAlsoSections":[{"anchor":"Articles","title":"Articles","identifiers":["doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/Licenses-Article","doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Services-Article","doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Files-Article"],"generated":true}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"To use LicenseKit in your product, simply create an internal ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEngine","isActive":true,"type":"reference"},{"text":" and add one or many ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType","isActive":true,"type":"reference"},{"text":"s to it, to determine from where it will try to find or fetch licenses.","type":"text"}],"type":"paragraph"},{"anchor":"License-Engine","type":"heading","level":2,"text":"License Engine"},{"inlineContent":[{"text":"To create a ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEngine","isActive":true,"type":"reference"},{"text":" instance, you must pass in your ","type":"text"},{"identifier":"https:\/\/kankoda.com\/licensekit","isActive":true,"type":"reference"},{"text":", then inject the ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType","isActive":true,"type":"reference"},{"text":"(s) that you want to use to validate your customer licenses.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For instance, this would create a license engine with two licenses that are compiled into your product and will be validated on-device:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let engine = try await LicenseEngine(","    licenseKey: \"your-license-key\",","    licenseService: { license in","        .binary(","            licenses: [","                License(licenseKey: \"license-key-1\", ...),","                License(licenseKey: \"license-key-2\", ...)","            ]","        )","    }",")"]},{"inlineContent":[{"text":"See the ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Services-Article","isActive":true,"type":"reference"},{"text":" article for a list of the available service types. You can define licenses with code, parse CSV or encrypted files, integrate with Gumroad or any 3rd party API, etc.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Once your app\/SDK has a license engine, it can use ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEngine\/getLicense(withKey:)","isActive":true,"type":"reference"},{"text":" to get and validate licenses. The engine will perform a basic license validation, after which you can perform additional validations on the current license.","type":"text"}],"type":"paragraph"},{"name":"Important","type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When using LicenseKit in an SDK, make sure to keep the license engine internal, to avoid that your users can access your licenses!"}]}]},{"anchor":"License-Store","type":"heading","level":2,"text":"License Store"},{"inlineContent":[{"text":"Most apps & SDKs will have a single license per running instance. For these cases, you can use a ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseStore","isActive":true,"type":"reference"},{"text":" to store the license.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can create an internal or private license store for your app\/SDK, then add a ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License","isActive":true,"type":"reference"},{"text":" extensions to easily fetch the current license:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension LicenseStore {","    static let myLibraryStore = LicenseStore()","}","","extension License {","    var current: License { ","        LicenseStore.myLibraryStore.license","    }","}"]},{"inlineContent":[{"text":"You can inject the store into your ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEngine","isActive":true,"type":"reference"},{"text":" to automatically store licenses that you receive with ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEngine\/getLicense(withKey:)","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let myLibraryEngine = try await LicenseEngine(","    licenseKey: \"your-license-key\",","    licenseStore: .myLibraryStore,","    licenseService: { license in ... }",")"]},{"name":"Important","type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Make sure to keep your license store and license engine internal, to avoid that your users can access them and inject fake licenses."}]}]},{"anchor":"License-Registration","type":"heading","level":2,"text":"License Registration"},{"inlineContent":[{"text":"Your software should provide a way for your customers to enter their license key. An app can have a UI\/screen, while an SDK can have a well-defined setup function like this one:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public final class MyLibrary {","","    \/\/ Place this kind of function in your library, where it makes sense. ","    \/\/ You don't need license keys when you use encrypted license files.","    public static func setupMyLibrary(","        withLicenseKey key: String? = nil","    ) async throws {","        let license = try await engine.getLicense(for: key)","        \/\/ If we get a license value, then the license is valid for the","        \/\/ current date, product, and platform. We can now perform more","        \/\/ validations, set up the app\/SDK using the license, store the","        \/\/ license for later feature\/tier validations, etc.","    }","}"]},{"inlineContent":[{"text":"The engine will retrieve and validate the first matching license from its ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType","isActive":true,"type":"reference"},{"text":"s, if any, else throw a ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseError","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"License-Validation","type":"heading","level":2,"text":"License Validation"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEngine","isActive":true,"type":"reference"},{"text":" will perform an initial license validation for the current date, product, and platform, which means that the license you get from it will meet this base requirements. You can then perform additional validations at any later time, to protect your software.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For instance, you can define a product-specific ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseFeature","isActive":true,"type":"reference"},{"text":" enum like this, to make sure that a user has access to that feature:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["enum MyLibraryFeature: String, LicenseFeature {","","    case pins, maps, weather, ...","","    var featureId: String? {","        switch self {","        case .pins: nil         \/\/ Pins doesn't require a license","        case .maps: .silver","        case .weather: .gold","        }","    }","","    var unlockedByTier: LicenseTier? {","        switch self {","        case .pins: nil         \/\/ Pins doesn't require a license","        case .maps: .silver","        case .weather: .gold","        }","    }","}"]},{"inlineContent":[{"text":"You can now validate that a license can access a feature, and even make it impossible to create types that are unavailable to the license:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ See \"License Store\" section.","public extension License {","","    var current: License { ... }","}","","\/\/ This feature only requires that a license exists.","public class MyBasicFeature {","    public init() throws {","        try License.validate(.current)","    }","}","","\/\/\/ This feature requires a license with the .maps feature.","public class MyMapsFeature {","    public init() throws {","        try License.validate(.current) { license in","            try license.validateFeature(MyLibraryFeature.maps)","        }","    }","}","","\/\/\/ This feature requires a license with the .weather feature.","public class MyWeatherFeature {","    public init() throws {","        try License.validate(.current) { license in","            try license.validateFeature(MyLibraryFeature.weather)","        }","    }","}"]},{"name":"Tip","type":"aside","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/validate(_:bundleId:date:platform:environment:productVersion:additionalValidation:)"},{"type":"text","text":" to ensure that the passed in license exists and is valid, after which you can perform additional validations."}]}]},{"anchor":"Apps","type":"heading","level":2,"text":"Apps"},{"inlineContent":[{"text":"LicenseKit has SwiftUI Previews-based apps templates that can be used by your app\/SDK’s source code to quickly create license apps.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseApp","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseManagerApp","isActive":true,"type":"reference"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A separate article will be created for this.","type":"text"}],"type":"paragraph"},{"anchor":"Demo-apps-and-inspiration","type":"heading","level":2,"text":"Demo apps and inspiration"},{"inlineContent":[{"text":"Have a look at the demo app and demo library for examples on how to do this. LicenseKit doesn’t put any restrictions on how you use the ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEngine","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseStore","isActive":true,"type":"reference"},{"text":", but you can use these demos for inspiration.","type":"text"}],"type":"paragraph"},{"anchor":"Further-reading","type":"heading","level":2,"text":"Further reading"},{"inlineContent":[{"text":"For more information, the ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/Licenses-Article","isActive":true,"type":"reference"},{"text":" article explains the license model, ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Services-Article","isActive":true,"type":"reference"},{"text":" the available services, and ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Files-Article","isActive":true,"type":"reference"},{"text":" how to generate encrypted license files.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://src.LicenseKit/documentation/LicenseKit/License-Files-Article":{"title":"Encrypted License Files","abstract":[{"text":"This article describes how to generate and read encrypted license files.","type":"text"}],"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Files-Article","url":"\/documentation\/licensekit\/license-files-article","kind":"article","type":"topic","role":"article"},"doc://src.LicenseKit/documentation/LicenseKit/License/validate(_:bundleId:date:platform:environment:productVersion:additionalValidation:)":{"title":"validate(_:bundleId:date:platform:environment:productVersion:additionalValidation:)","identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/validate(_:bundleId:date:platform:environment:productVersion:additionalValidation:)","abstract":[{"text":"Validate the provided license, if any.","type":"text"}],"url":"\/documentation\/licensekit\/license\/validate(_:bundleid:date:platform:environment:productversion:additionalvalidation:)","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"validate"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"License","preciseIdentifier":"s:10LicenseKit0A0V"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"bundleId"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?, "},{"kind":"externalP