{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"LicenseKit has a "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License","type":"reference","isActive":true},{"type":"text","text":" type that represents a software license. A license can specify an "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/activationDate","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/expirationDate","type":"reference","isActive":true},{"text":", a ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier","type":"reference","isActive":true},{"type":"text","text":", a "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseCustomer","type":"reference","isActive":true},{"type":"text","text":" and supported "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/bundleIds","type":"reference","isActive":true},{"type":"text","text":", platforms, environments, features, etc."}]},{"type":"heading","level":2,"anchor":"License-Validation","text":"License Validation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use "},{"type":"codeVoice","code":"License\/validate(_:bundleId:date:platform:environment:productVersion:additionalValidation:)"},{"type":"text","text":" to validate the provided license for all provided criterias. See the "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/Getting-Started-Article","type":"reference","isActive":true},{"type":"text","text":" article for more information."}]},{"type":"heading","level":3,"anchor":"%F0%9F%93%A6-Bundle","text":"📦 Bundle"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A license can be valid for one or multiple product "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/bundleIds","type":"reference","isActive":true},{"type":"text","text":". This allows you to set different prices for the number of products that a license can be used in. You can use a .* wildcard suffix to support all bundles with a certain prefix."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"LicenseKit will automatically validate a license for the current bundle. If the license doesn’t specify a bundle, all bundles are supported."}]},{"type":"heading","level":3,"anchor":"%F0%9F%93%86-Expiration-Date","text":"📆 Expiration Date"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A license can define various dates, like "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/activationDate","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/renewalDate","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/expirationDate","type":"reference","isActive":true},{"type":"text","text":", etc. While most dates exist to keep track of the license lifecycle, the "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/expirationDate","type":"reference","isActive":true},{"type":"text","text":" will automatically expire a license."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"LicenseKit will automatically validate a license for the current date. A license that doesn’t have an "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/expirationDate","type":"reference","isActive":true},{"type":"text","text":" will never expire."}]},{"type":"heading","level":3,"anchor":"%E2%98%81%EF%B8%8F-Environment","text":"☁️ Environment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEnvironment","type":"reference","isActive":true},{"type":"text","text":" enum defines different environments that a "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License","type":"reference","isActive":true},{"type":"text","text":" can support, like "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEnvironment\/test","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEnvironment\/production","type":"reference","isActive":true},{"type":"text","text":". This allows you to set different prices for the number of environments that a license supports."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"LicenseKit doesn’t validate this by default, but you can do it manually. If the license doesn’t specify "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/environments","type":"reference","isActive":true},{"type":"text","text":", all are supported."}]},{"type":"heading","level":3,"anchor":"%F0%9F%93%B1-Platform","text":"📱 Platform"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicensePlatform","type":"reference","isActive":true},{"type":"text","text":" enum defines different platforms that a "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License","type":"reference","isActive":true},{"type":"text","text":" can support, like "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicensePlatform\/iOS","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicensePlatform\/macOS","type":"reference","isActive":true},{"type":"text","text":". This allows you to set different prices for the number of platforms that a license supports."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"LicenseKit will automatically validate a license for the "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicensePlatform\/current","type":"reference","isActive":true},{"type":"text","text":" platform. If the license doesn’t specify "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/platforms","type":"reference","isActive":true},{"type":"text","text":", all are supported."}]},{"type":"heading","level":3,"text":"🔢 Product Version","anchor":"%F0%9F%94%A2-Product-Version"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A license can define an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/expirationProductVersion"},{"type":"text","text":", from which it will expire. This lets you cap a license to a certain max version."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"KeyboardKit doesn’t perform product version validation by default. You can use pass in an product version when calling "},{"type":"codeVoice","code":"License\/validate(_:bundleId:date:platform:environment:productVersion:additionalValidation:)"},{"text":".","type":"text"}]},{"type":"heading","level":2,"text":"License Tiers","anchor":"License-Tiers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier"},{"type":"text","text":" defines the level of service that a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License"},{"type":"text","text":" has access to. You can use any of the pre-defined tiers to use common names like "},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier\/small","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier\/medium","type":"reference"},{"text":" and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier\/large"},{"type":"text","text":", "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier\/basic","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier\/silver","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier\/gold","type":"reference","isActive":true},{"type":"text","text":", etc. You can define also your own tiers:"}]},{"type":"codeListing","code":["extension LicenseTier {","    static let everything = Self(","        id: \"com.mylibrary.license.everything\",","        name: \"The Everything Tier\",","        level: 1_000","    )","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"You can make certain types or features require a certain tier. For instance, this type requires at least a "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier\/silver","isActive":true,"type":"reference"},{"type":"text","text":" tier to even be created:"}],"type":"paragraph"},{"type":"codeListing","code":["public class SilverFeature {","    public init() throws {","        try License.validate(.current) { license in","            try license.validateTier(.silver)","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"You can use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTierGroup"},{"type":"text","text":" to get common license combinations, like "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTierGroup\/value"},{"type":"text","text":", "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTierGroup\/size","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTierGroup\/business","type":"reference","isActive":true},{"type":"text","text":", but you can also use the various tiers as you see fit."}],"type":"paragraph"},{"anchor":"License-Features","text":"License Features","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseFeature","type":"reference","isActive":true},{"type":"text","text":" protocol can be implemented by any type that can be unlocked with a license. This allows you to set different prices based on the features a license includes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can turn any type or enum into a feature by implementing the "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseFeature","type":"reference","isActive":true},{"type":"text","text":" protocol. You can let an entire type implement it, or let certain enum cases define a "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseFeature\/featureId","type":"reference","isActive":true},{"type":"text","text":" to indicate that they are license features:"}],"type":"paragraph"},{"type":"codeListing","code":["enum AppFeature: String, LicenseFeature {","    case .requiresLicense, .doesNotRequireLicense","    ","    var featureId: String? { ","        switch self {","        case .requiresLicense: rawValue     \/\/ This is a license feature","        case .doesNotRequireLicense: nil    \/\/ This is not a license feature","        }","    }","","    var unlockedByTier: Tier? { .gold","        case .requiresLicense: .gold        \/\/ This is automatically unlocked by gold","        case .doesNotRequireLicense: nil    \/\/ This doesn't need a tier to be accessed","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"We can now add this feature to any license that should have access to it (you can also do this while mapping external license values):"}],"type":"paragraph"},{"type":"codeListing","code":["var license1 = License(licenseKey: \"1\")","var license2 = License(licenseKey: \"2\",  features: [AppFeature.requiresLicense])","var license3 = License(licenseKey: \"3\", tier: .gold)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"We can then validate if a license has access to a certain feature:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ The first case requires either the feature or the tier","license1.validateFeature(AppFeature.requiresLicense)    \/\/ False","license2.validateFeature(AppFeature.requiresLicense)    \/\/ True, because of feature","license3.validateFeature(AppFeature.requiresLicense)    \/\/ True, because of tier","","\/\/ The second case doesn't require a license and always succeeds","license1.validateFeature(AppFeature.doesNotRequireLicense) \/\/ True","license2.validateFeature(AppFeature.doesNotRequireLicense) \/\/ True","license3.validateFeature(AppFeature.doesNotRequireLicense) \/\/ True"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"You can use feature validation everywhere, for instance to call certain functions and to even make it impossible to create an instance of a type that requires a certain feature if the current license lacks that feature:"}],"type":"paragraph"},{"type":"codeListing","code":["class DictationService {","","    init() throws {","        try License.validate(.current) { license in","            try license.validateFeature(AppFeatures.dictation)","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"If you try to create a "},{"type":"codeVoice","code":"DictationService"},{"type":"text","text":" instance with a license that doesn’t allow "},{"type":"codeVoice","code":".dictation"},{"type":"text","text":", it will throw a "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseError","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/licensekit\/licenses-article"]}],"metadata":{"title":"Licenses","role":"article","modules":[{"name":"LicenseKit"}],"roleHeading":"Article"},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/Licenses-Article"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/src.LicenseKit\/documentation\/LicenseKit"]]},"sections":[],"abstract":[{"type":"text","text":"This article describes the LicenseKit license model."}],"seeAlsoSections":[{"title":"Articles","identifiers":["doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/Getting-Started-Article","doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Services-Article","doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Files-Article"],"generated":true,"anchor":"Articles"}],"references":{"doc://src.LicenseKit/documentation/LicenseKit/LicenseTier/gold":{"type":"topic","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"gold","kind":"identifier"},{"text":": `Self`","kind":"text"}],"url":"\/documentation\/licensekit\/licensetier\/gold","title":"gold","kind":"symbol","abstract":[{"text":"A gold tier with level of ","type":"text"},{"type":"codeVoice","code":"2"},{"text":".","type":"text"}],"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier\/gold"},"doc://src.LicenseKit/documentation/LicenseKit/LicenseEnvironment":{"type":"topic","role":"symbol","identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEnvironment","abstract":[{"text":"This enum defines various environments that licenses can","type":"text"},{"type":"text","text":" "},{"type":"text","text":"be used with, such as "},{"type":"reference","identifier":"doc:\