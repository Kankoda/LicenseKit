{"abstract":[{"text":"This article describes the LicenseKit license model.","type":"text"}],"variants":[{"paths":["\/documentation\/licensekit\/licenses-article"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Licenses","role":"article","modules":[{"name":"LicenseKit"}],"roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"LicenseKit has a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License","type":"reference"},{"text":" type that represents a software license. A license can specify an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/activationDate","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/expirationDate","type":"reference"},{"text":", a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier","type":"reference"},{"text":", a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseCustomer","type":"reference"},{"text":" and supported ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/bundleIds","type":"reference"},{"text":", platforms, environments, features, etc.","type":"text"}]},{"anchor":"License-Validation","type":"heading","level":2,"text":"License Validation"},{"type":"paragraph","inlineContent":[{"text":"You can use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/validate(_:bundleId:date:platform:environment:productVersion:additionalValidation:)","type":"reference"},{"text":" to validate the provided license for all provided criterias. See the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/Getting-Started-Article","type":"reference"},{"text":" article for more information.","type":"text"}]},{"anchor":"%F0%9F%93%A6-Bundle","type":"heading","level":3,"text":"📦 Bundle"},{"type":"paragraph","inlineContent":[{"text":"A license can be valid for one or multiple product ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/bundleIds","type":"reference"},{"text":". This allows you to set different prices for the number of products that a license can be used in. You can use a .* wildcard suffix to support all bundles with a certain prefix.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"LicenseKit will automatically validate a license for the current bundle. If the license doesn’t specify a bundle, all bundles are supported.","type":"text"}]},{"anchor":"%F0%9F%93%86-Expiration-Date","type":"heading","level":3,"text":"📆 Expiration Date"},{"type":"paragraph","inlineContent":[{"text":"A license can define various dates, like ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/activationDate","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/renewalDate","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/expirationDate","type":"reference"},{"text":", etc. While most dates exist to keep track of the license lifecycle, the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/expirationDate","type":"reference"},{"text":" will automatically expire a license.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"LicenseKit will automatically validate a license for the current date. A license that doesn’t have an ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/expirationDate","isActive":true,"type":"reference"},{"text":" will never expire.","type":"text"}]},{"anchor":"%E2%98%81%EF%B8%8F-Environment","type":"heading","level":3,"text":"☁️ Environment"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEnvironment","isActive":true,"type":"reference"},{"text":" enum defines different environments that a ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License","isActive":true,"type":"reference"},{"text":" can support, like ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEnvironment\/test","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEnvironment\/production","type":"reference"},{"text":". This allows you to set different prices for the number of environments that a license supports.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"LicenseKit doesn’t validate this by default, but you can do it manually. If the license doesn’t specify ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/environments","type":"reference"},{"text":", all are supported.","type":"text"}]},{"text":"📱 Platform","level":3,"type":"heading","anchor":"%F0%9F%93%B1-Platform"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicensePlatform","type":"reference"},{"text":" enum defines different platforms that a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License","type":"reference"},{"text":" can support, like ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicensePlatform\/iOS","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicensePlatform\/macOS","type":"reference"},{"text":". This allows you to set different prices for the number of platforms that a license supports.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"LicenseKit will automatically validate a license for the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicensePlatform\/current","type":"reference"},{"text":" platform. If the license doesn’t specify ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/platforms","type":"reference"},{"text":", all are supported.","type":"text"}]},{"anchor":"%F0%9F%94%A2-Product-Version","type":"heading","level":3,"text":"🔢 Product Version"},{"type":"paragraph","inlineContent":[{"text":"A license can define an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/expirationProductVersion","type":"reference"},{"text":", from which it will expire. This lets you cap a license to a certain max version.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"KeyboardKit doesn’t perform product version validation by default. You can use pass in an product version when calling ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/validate(_:bundleId:date:platform:environment:productVersion:additionalValidation:)","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"anchor":"License-Tiers","type":"heading","level":2,"text":"License Tiers"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier","type":"reference"},{"text":" defines the level of service that a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License","type":"reference"},{"text":" has access to. You can use any of the pre-defined tiers to use common names like ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier\/small","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier\/medium","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier\/large","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier\/basic","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier\/silver","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier\/gold","type":"reference"},{"text":", etc. You can define also your own tiers:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension LicenseTier {","    static let everything = Self(","        id: \"com.mylibrary.license.everything\",","        name: \"The Everything Tier\",","        level: 1_000","    )","}"]},{"inlineContent":[{"text":"You can make certain types or features require a certain tier. For instance, this type requires at least a ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTier\/silver","isActive":true,"type":"reference"},{"text":" tier to even be created:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public class SilverFeature {","    public init() throws {","        try License.validate(.current) { license in","            try license.validateTier(.silver)","        }","    }","}"]},{"inlineContent":[{"text":"You can use the ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTierGroup","isActive":true,"type":"reference"},{"text":" to get common license combinations, like ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTierGroup\/value","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTierGroup\/size","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseTierGroup\/business","isActive":true,"type":"reference"},{"text":", but you can also use the various tiers as you see fit.","type":"text"}],"type":"paragraph"},{"text":"License Features","level":2,"type":"heading","anchor":"License-Features"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseFeature","isActive":true,"type":"reference"},{"text":" protocol can be implemented by any type that can be unlocked with a license. This allows you to set different prices based on the features a license includes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can turn any type or enum into a feature by implementing the ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseFeature","isActive":true,"type":"reference"},{"text":" protocol. You can let an entire type implement it, or let certain enum cases define a ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseFeature\/featureId","isActive":true,"type":"reference"},{"text":" to indicate that they are license features:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["enum AppFeature: String, LicenseFeature {","    case .requiresLicense, .doesNotRequireLicense","    ","    var featureId: String? { ","        switch self {","        case .requiresLicense: rawValue     \/\/ This is a license feature","        case .doesNotRequireLicense: nil    \/\/ This is not a license feature","        }","    }","","    var unlockedByTier: Tier? { .gold","        case .requiresLicense: .gold        \/\/ This is automatically unlocked by gold","        case .doesNotRequireLicense: nil    \/\/ This doesn't need a tier to be accessed","    }","}"]},{"inlineContent":[{"type":"text","text":"We can now add this feature to any license that should have access to it (you can also do this while mapping external license values):"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var license1 = License(licenseKey: \"1\")","var license2 = License(licenseKey: \"2\",  features: [AppFeature.requiresLicense])","var license3 = License(licenseKey: \"3\", tier: .gold)"]},{"inlineContent":[{"type":"text","text":"We can then validate if a license has access to a certain feature:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ The first case requires either the feature or the tier","license1.validateFeature(AppFeature.requiresLicense)    \/\/ False","license2.validateFeature(AppFeature.requiresLicense)    \/\/ True, because of feature","license3.validateFeature(AppFeature.requiresLicense)    \/\/ True, because of tier","","\/\/ The second case doesn't require a license and always succeeds","license1.validateFeature(AppFeature.doesNotRequireLicense) \/\/ True","license2.validateFeature(AppFeature.doesNotRequireLicense) \/\/ True","license3.validateFeature(AppFeature.doesNotRequireLicense) \/\/ True"]},{"inlineContent":[{"type":"text","text":"You can use feature validation everywhere, for instance to call certain functions and to even make it impossible to create an instance of a type that requires a certain feature if the current license lacks that feature:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["class DictationService {","","    init() throws {","        try License.validate(.current) { license in","            try license.validateFeature(AppFeatures.dictation)","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"If you try to create a "},{"type":"codeVoice","code":"DictationService"},{"type":"text","text":" instance with a license that doesn’t allow "},{"type":"codeVoice","code":".dictation"},{"type":"text","text":", it will throw a "},{"type":"reference","identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseError","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/Licenses-Article","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Articles","identifiers":["doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/Getting-Started-Article","doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Services-Article","doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Files-Article"],"title":"Articles","generated":true}],"kind":"article","hierarchy":{"paths":[["doc:\/\/src.LicenseKit\/documentation\/LicenseKit"]]},"sections":[],"references":{"doc://src.LicenseKit/documentation/LicenseKit":{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit","type":"topic","abstract":[{"type":"text","text":"LicenseKit helps you protect your Swift-based software with commercial licenses."}],"role":"collection","title":"LicenseKit","url":"\/documentation\/licensekit","kind":"symbol"},"doc://src.LicenseKit/documentation/LicenseKit/LicenseEnvironment":{"kind":"symbol","title":"LicenseEnvironment","navigatorTitle":[{"kind":"identifier","text":"LicenseEnvironment"}],"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEnvironment","abstract":[{"type":"text","text":"This enum defines various environments that licenses can"},{"type":"text","text":" "},{"type":"text","text":"be used with, such as "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\