{"identifier":{"url":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Services-Article","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/src.LicenseKit\/documentation\/LicenseKit"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"LicenseKit"}],"role":"article","title":"License Services"},"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"LicenseKit has many different service types that access licenses in different ways. You can for instance define licenses with code and compile them into your product, generate and parse CSV and encrypted files, integrate with 3rd party APIs, etc.","type":"text"}],"type":"paragraph"},{"anchor":"Service-Types","text":"Service Types","level":2,"type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType"},{"text":" enum defines all available service types:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType\/api(configuration:urlSession:licenseMapping:)","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType\/binary(licenses:)","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType\/cached(service:maxAge:)","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType\/csvFile(fileName:fileExtension:bundle:componentSeparator:licenseMapping:)","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType\/csvFileUrl(_:componentSeparator:licenseMapping:)","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType\/gumroad(productId:urlSession:licenseMapping:)","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType\/licenseFile(fileName:fileExtension:fileGenerator:fileBundle:)","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType\/proxy(services:)","type":"reference","isActive":true}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"You can specify which service type(s) to use when creating a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseEngine"},{"text":" instance, as described in ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/Getting-Started-Article"},{"text":". This article has examples for every license service type, in alphabetic order.","type":"text"}],"type":"paragraph"},{"anchor":"%E2%98%81%EF%B8%8F-API-Integrations","text":"☁️ API Integrations","level":3,"type":"heading"},{"inlineContent":[{"text":"You can use API license services to integrate with any Rest API, by making network requests and parsing API responses to a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To map licenses from a specific API, you must define a custom ","type":"text"},{"type":"codeVoice","code":"Decodable"},{"text":" type that can decode a specific API response, for instance:","type":"text"}],"type":"paragraph"},{"code":["struct MyApiLicense: Decodable {","","    let licenseKey: String","    let customerName: String","    let tier: String","","    var license: License {","        License(","            licenseKey: licenseKey,","            customer: .init(name: customerName)","            tier: .init(name: tier)","        )","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This type would be able to map the following response right away, and can define custom "},{"type":"codeVoice","code":"CodingKeys"},{"type":"text","text":" to support custom mappings:"}],"type":"paragraph"},{"code":["{","    \"licenseKey\": \"ABC123\",","    \"tier\": \"gold\",","    \"customerName\": \"Cool Company Ltd.\"","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can now setup an API service with an API-specific config and a mapping function that decodes data and maps it to a "},{"type":"reference","identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["let engine = try await LicenseEngine(","    licenseKey: \"your-licensekit-license-key\"",") { _ in","    try .api(","        configuration: .init(","            url: { licenseKey in URL(string: \"https:\/\/myapi.com\/licenses\/\\(licenseKey)\")! },","            httpMethod: { _ in \"POST\" },","            httpHeaders: { _ in [\"api-token\": \"ejiwaogja=\"] }","        ),","        licenseMapping { data in","            let decoder = JSONDecoder()","            let apiLicense = try decoder.decode(MyApiLicenseModel.self, from: data)","            return apiLicense.license","        }","    )","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This way to provide an API-specific configuration and mapping function lets you customize this general API service to great extent.","type":"text"}]},{"text":"📦 Binary Licenses","type":"heading","level":3,"anchor":"%F0%9F%93%A6-Binary-Licenses"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Binary licenses are defined in code that is coded into your binary and validated on-device. You can for instance define licenses like this:"}]},{"type":"codeListing","code":["extension License {","","    \/\/\/ A basic license that only defines a license key","    static let basicLicense = License(","        licenseKey: \"DCE54718-A214-40E7-B3E8-3C7B1967F485\")","","    \/\/\/ A license that defines more information:","    static let extensiveLicense = License(","        licenseKey: \"ABCDEFGH-IJKL-MNOP-QRST-UVWXYZ123456\"","        tier: .gold,","        expirationDate: Date(year: 2025, month: 01, day: 01),","        platforms: [.iOS, .tvOS],","        bundleIds: [\"com.customer.library\"]","    )","}"],"syntax":"swift"},{"inlineContent":[{"text":"You can create license collections to define convenient access to your binary licenses, then setup a license engine with these licenses:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["extension Collection where Element == License {","","    static var myLicenses: [LicenseCustomer] {","        [.basicLicense, .extensiveLicense]","    }","}","","let engine = try await LicenseEngine(","    licenseKey: \"your-licensekit-license-key\"",") { _ in","    .binary(licenses: .myLicenses)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Binary licenses are powerful, but require that you to release a new version of your software to add or remove licenses for your product."}]},{"type":"heading","anchor":"%F0%9F%97%84%EF%B8%8F-Cached-Service","level":3,"text":"🗄️ Cached Service"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use a cached license service to cache any license validation from any other license service. This makes it possible for a user to keep using your software even if the device is temporarily disconnected."}]},{"type":"codeListing","syntax":"swift","code":["let engine = try await LicenseEngine(","    licenseKey: \"your-licensekit-license-key\"",") { _ in","    .cached(service: .gumroad(...))","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cache will only keep licenses around for external errors. Any validations that fail due to a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseError"},{"type":"text","text":" will cause the cache to reset and the validation to fail with the original error."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default, a cached service will always call the wrapped service, and only use the cache as a fallback. You can provide a "},{"type":"codeVoice","code":"maxAge"},{"text":" to return cached licenses without calling the wrapped service, until they are older than the max age:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let engine = try await LicenseEngine(","    licenseKey: \"your-licensekit-license-key\"",") { _ in","    .cached(service: .gumroad(...), maxAge: 7 * 24 * 60 * 60)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Expired licenses are never returned from the cache."}]},{"type":"heading","anchor":"%F0%9F%93%84-CSV-Files","level":3,"text":"📄 CSV Files"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use CSV files to define a large collection of licenses, where each row defines an individual license that you can parse with code:"}]},{"type":"codeListing","code":["DCE54718-A214-40E7-B3E8-3C7B1967F485,Microsoft,BASIC,2023-10-01","ABCDEFGH-IJKL-MNOP-QRST-UVWXYZ123456,Apple,GOLD,2023-01-01","..."],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"You can use ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType\/csvFile(fileName:fileExtension:bundle:componentSeparator:licenseMapping:)","isActive":true,"type":"reference"},{"text":" to parse bundle files, or ","type":"text"},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType\/csvFileUrl(_:componentSeparator:licenseMapping:)","isActive":true,"type":"reference"},{"text":" to fetch files from any URL:","type":"text"}]},{"type":"codeListing","code":["let engine = try await LicenseEngine(","    licenseKey: \"your-licensekit-license-key\"",") { engineLicense in","    .csvFile(","        fileName: \"licenses\",","        fileExtension: \"csv\",","        bundle: ..., \/\/ .main (app), .module (.package), or custom for binary.","        componentSeparator: \",\"","    ) { rows in","        rows.map {","            License(","                licenseKey: row[0],","                customer: .init(name: row[1])","                tier: .init(name: row[2])","            )","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The code above parses a license file by mapping each row to a license by using the first value as license key, the second as customer (company) name, and the third as license tier (“basic”, “silver”, “enterprise”, etc.)."}]},{"text":"🌩️ Gumroad Integrations","anchor":"%F0%9F%8C%A9%EF%B8%8F-Gumroad-Integrations","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"You can use a Gumroad license service to integrate with the Gumroad license API. It will automatically map Gumroad purchase data to a license, and lets you provide a custom license mapping function that maps the raw Gumroad response to a "},{"type":"reference","identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let engine = try await LicenseEngine(","    licenseKey: \"your-licensekit-license-key\"",") { engineLicense in","    .gumroad(","        productId: \"unique-product-id\",","        licenseMapping: { response in","            var license = response.license  \/\/ The default license map","            \/\/ You can customize or replace this standard license here","            return license","        }","    )","}"],"type":"codeListing"},{"inlineContent":[{"text":"You can either just return the response’s original license, customize or replace the license, or handle the response in any way you want.","type":"text"}],"type":"paragraph"},{"text":"🔐 License Files","anchor":"%F0%9F%94%90-License-Files","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"You can use a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseFileGenerator"},{"text":" to generate encrypted license files, then use an license file service to parse these files:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let engine = try await LicenseEngine(","    licenseKey: \"your-licensekit-license-key\"",") { engineLicense in","    .licenseFile(","        fileName: \"MyLibrary\",","        fileExtension: \"license\",","        generator: .myLicenseFileGenerator","    )","}"],"type":"codeListing"},{"inlineContent":[{"text":"See ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Files-Article"},{"type":"text","text":" for more information on how to create a unique encryption key and file generator for your app\/SDK."}],"type":"paragraph"},{"text":"🔀 Proxy Services","type":"heading","level":3,"anchor":"%F0%9F%94%80-Proxy-Services"},{"type":"paragraph","inlineContent":[{"text":"You can use a proxy service to combine several license services into a single one. This makes is possible to fetch licenses in many ways.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let engine = try await LicenseEngine(","    licenseKey: \"your-licensekit-license-key\"",") { engineLicense in","    .proxy(","        services: [","            .binary(...),","            .gumroad(...)","        ]","    )","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A proxy service lets you to fetch licenses from multiple sources. You can apply a different "},{"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License\/source-swift.property","type":"reference","isActive":true},{"type":"text","text":" with each service to determine from where a license originates."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/licensekit\/license-services-article"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Articles","identifiers":["doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/Getting-Started-Article","doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/Licenses-Article","doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/License-Files-Article"],"generated":true,"anchor":"Articles"}],"abstract":[{"text":"This article describes the LicenseKit license service model and how to define and validate licenses.","type":"text"}],"references":{"doc://src.LicenseKit/documentation/LicenseKit/LicenseServiceType/proxy(services:)":{"title":"LicenseServiceType.proxy(services:)","role":"symbol","type":"topic","url":"\/documentation\/licensekit\/licenseservicetype\/proxy(services:)","abstract":[{"text":"A license service proxy.","type":"text"}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"text":"proxy","kind":"identifier"},{"text":"(","kind":"text"},{"text":"services","kind":"externalParam"},{"text":": [","kind":"text"},{"text":"LicenseServiceType","preciseIdentifier":"s:10LicenseKit0A11ServiceTypeO","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"identifier":"doc:\/\/src.LicenseKit\/documentation\/LicenseKit\/LicenseServiceType\/proxy(services:)","kind":"symbol"},"doc://src.LicenseKit/documentation/LicenseKit/LicenseServiceType/binary(licenses:)":{"type":"topic","fragments":[{